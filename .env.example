# Cyber Shield SIEM - Environment Variables
# Copy this file to .env and fill in your values

# Flask Secret Key (REQUIRED - change in production!)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Server Configuration
HOST=0.0.0.0
PORT=5000
DEBUG=False

# Database
# SQLite is used by default. For production, database is stored in /data/ directory.

# Alert Email Configuration (optional)
# ALERT_EMAIL_ENABLED=False
# ALERT_EMAIL_SERVER=smtp.gmail.com
# ALERT_EMAIL_PORT=587
# ALERT_EMAIL_USER=your-email@gmail.com
# ALERT_EMAIL_PASS=your-app-password
# ALERT_EMAIL_TO=admin@example.com

